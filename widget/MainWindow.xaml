<Window x:Class="EverlastimerWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverlastimerWidget"
        Title="Everlastimer Widget"
        Width="680" Height="480"
        MinWidth="400" MinHeight="280"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        SizeChanged="Window_SizeChanged"
        Topmost="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A072FF"/>

        <Style x:Key="InvisibleThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        
        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Width="680" Height="460" CornerRadius="28" Padding="32,28,32,24"
                    MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
                
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E6150E26" Offset="0"/>
                        <GradientStop Color="#F20B0714" Offset="0.5"/>
                        <GradientStop Color="#F206040A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                        <GradientStop Color="#05FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="50" ShadowDepth="10" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <Ellipse Width="350" Height="350" Fill="#8A4DFF" Opacity="0.10" 
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-100,0,0">
                        <Ellipse.Effect>
                            <BlurEffect Radius="140"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="300" Height="300" Fill="#F08BFF" Opacity="0.08" 
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80">
                        <Ellipse.Effect>
                            <BlurEffect Radius="120"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Height="1" VerticalAlignment="Top" Margin="4,0,4,0" Background="#4CFFFFFF" Opacity="0.10"/>

                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="14" Height="14" Fill="{StaticResource AccentPurple}" Margin="0,0,12,0"/>
                                <TextBlock Text="EVERLASTIMER" Foreground="{StaticResource TextPrimary}"
                                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PinButton" Content="&#128204;" Width="28" Height="28"
                                        Background="Transparent" BorderThickness="0" FontSize="14"
                                        Foreground="{StaticResource TextSecondary}" Cursor="Hand"
                                        Click="PinButton_Click" ToolTip="Lock position &amp; size" Margin="0,0,8,0"/>
                                <Button x:Name="MenuButton" Content="&#8943;" Width="28" Height="28"
                                        Background="Transparent" BorderThickness="0" FontSize="18"
                                        Foreground="{StaticResource TextSecondary}" Cursor="Hand"
                                        Click="MenuButton_Click" ToolTip="Options">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="OptionsMenu">
                                            <MenuItem x:Name="LockMenuItem" Header="Lock Position" Click="LockMenuItem_Click" IsCheckable="True"/>
                                            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top" Click="AlwaysOnTopMenuItem_Click" IsCheckable="True" IsChecked="True"/>
                                            <MenuItem Header="Reset Size &amp; Position" Click="ResetMenuItem_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Close Widget" Click="CloseMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="10,0,10,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> 
                                <ColumnDefinition Width="Auto"/> 
                                <ColumnDefinition Width="*"/>    
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,32,0">
                                <Grid Width="220" Height="220">
                                    <local:ProgressRing x:Name="RingControl" Width="220" Height="220"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,-4">
                                            <Run x:Name="PercentRun" Text="50.9" FontSize="48" FontWeight="Bold" Foreground="White"/>
                                            <Run Text="%" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                        </TextBlock>
                                        <TextBlock Text="of year completed" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondary}" FontWeight="Medium"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Border Grid.Column="1" Width="1" Background="#FFFFFF" Opacity="0.05" VerticalAlignment="Stretch" Margin="0,10,0,10"/>

                            <Grid Grid.Column="2" Margin="40,0,0,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="YearText" Text="2026" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" Margin="0,0,0,24"/>

                                <StackPanel Grid.Row="1">
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#0CFFFFFF">
                                            <TextBlock Text="&#128197;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <TextBlock x:Name="DaysCompletedText" Text="185" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="days completed" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#0CFFFFFF">
                                            <TextBlock Text="&#9203;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <TextBlock x:Name="DaysRemainingText" Text="180" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="days remaining" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="2" Background="#08FFFFFF" CornerRadius="16"
                                BorderBrush="#0CFFFFFF" BorderThickness="1" Padding="20,14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="1" Background="#FFFFFF" Opacity="0.03" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Margin="0,6,0,6"/>
                                <Border Width="1" Background="#FFFFFF" Opacity="0.03" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Left" Margin="0,6,0,6"/>
                                <Border Width="1" Background="#FFFFFF" Opacity="0.03" Grid.Column="3" Grid.Row="0" HorizontalAlignment="Left" Margin="0,6,0,6"/>

                                <StackPanel Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="BUDGET" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SupportBudgetText" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="SupportBudgetSuffix" Text="budget" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="RAISED" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SupportRaisedText" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="SupportRaisedSuffix" Text="received" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="HOSTING" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SupportHostingText" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="SupportHostingSuffix" Text="expense" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="DATABASE" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SupportDatabaseText" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="SupportDatabaseSuffix" Text="expense" FontSize="11" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#04FFFFFF" CornerRadius="8" Margin="4,14,4,0" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="CDN" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SupportCdnText" Text="--" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="APIs" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SupportApisText" Text="--" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="OTHER" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="0,0,4,0" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SupportOtherText" Text="--" FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="4,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Stay aware. Make it count." FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" FontWeight="Medium"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="UpdatedText" Text="Updated 7:30 PM" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Viewbox>

        <Thumb Style="{StaticResource InvisibleThumbStyle}" Width="10" HorizontalAlignment="Left" Margin="0,32,0,32" Cursor="SizeWE" DragDelta="ResizeLeft_DragDelta"/>
        <Thumb Style="{StaticResource InvisibleThumbStyle}" Width="10" HorizontalAlignment="Right" Margin="0,32,0,32" Cursor="SizeWE" DragDelta="ResizeRight_DragDelta"/>
        <Thumb Style="{StaticResource InvisibleThumbStyle}" Height="10" VerticalAlignment="Top" Margin="32,0,32,0" Cursor="SizeNS" DragDelta="ResizeTop_DragDelta"/>
        <Thumb Style="{StaticResource InvisibleThumbStyle}" Height="10" VerticalAlignment="Bottom" Margin="32,0,32,0" Cursor="SizeNS" DragDelta="ResizeBottom_DragDelta"/>
        
    </Grid>
</Window>
